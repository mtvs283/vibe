    "card.p1-01.meaning": {
      "en": "I brought this disaster upon myself.",
      "ne": "यो विपत्ति मैले आफैंले निम्त्याएको हुँ।",
      "my": "ဤဘေးအန္တရာယ်ကို ကျွန်ုပ်ကိုယ်တိုင် ဖိတ်ခေါ်ခဲ့သည်။",
      "km": null,
      "hi": "यह मुसीबत मैंने खुद अपने ऊपर मोल ली।",
      "bn": "এই বিপদ আমি নিজেই নিজের ওপর ডেকে এনেছি।",
      "ar": "جلبت هذه الكارثة على نفسي بنفسي.",
      "es": "Yo mismo me busqué este desastre.",
      "fr": "Je me suis attiré ce désastre moi-même.",
      "de": "Ich habe mir dieses Desaster selbst eingebrockt.",
      "sw": "Nilijiletea msiba huu mwenyewe.",
      "ha": "Na jawo wa kaina wannan bala'i da kaina.",
      "fil": "Ako mismo ang may kagagawan ng sakunang ito."
    },
    "card.p1-04.meaning": {
      "en": "One rule for me, another for you.",
      "ne": "मेरो लागि एक नियम, तपाईंको लागि अर्को।",
      "my": "ငါ့အတွက် စည်းကမ်းတစ်ခု၊ သင့်အတွက် တခြားတစ်ခု။",
      "km": null,
      "hi": "मेरे लिए एक नियम, तुम्हारे लिए दूसरा।",
      "bn": "নিজের জন্য এক নিয়ম, অন্যের জন্য আরেক নিয়ম।",
      "ar": "قاعدة لي وأخرى لك.",
      "es": "Una regla para mí, otra para ti.",
      "fr": "Une règle pour moi, une autre pour toi.",
      "de": "Eine Regel für mich, eine andere für dich.",
      "sw": "Sheria moja kwangu, nyingine kwako.",
      "ha": "Doka daya a gareni, wata kuma a gareka.",
      "fil": "Isang panuntunan para sa akin, iba naman para sa iyo."
    },
    "proverb::굼벵이도 구르는 재주가 있다": {
