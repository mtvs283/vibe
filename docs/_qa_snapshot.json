    "proverb::벼는 익을수록 고개를 숙인다": {
      "ko": "벼는 익을수록 고개를 숙인다",
      "en": "The fuller the ear, the lower it bows.",
      "ne": {
        "text": "जति ज्ञान बढ्छ, त्यति नै विनम्रता बढ्नुपर्छ।",
        "type": "paraphrase",
        "note": "loose"
      },
      "my": {
        "text": "ပညာရှိလေလေ နှိမ့်ချမှု ရှိသင့်လေဖြစ်သည်။",
        "type": "paraphrase",
        "note": "loose"
      },
      "km": {
        "text": null,
        "type": null,
        "note": null
      },
      "hi": {
        "text": "जितना ज्ञान बढ़े, उतनी विनम्रता बढ़नी चाहिए।",
        "type": "paraphrase",
        "note": "loose"
      },
      "bn": {
        "text": "যত জ্ঞান বাড়ে, তত বিনয় বাড়া উচিত।",
        "type": "paraphrase",
        "note": "loose"
      },
      "ar": {
        "text": "كلما ازداد المرء علماً ازداد تواضعاً.",
        "type": "paraphrase",
        "note": "loose"
      },
      "es": {
        "text": "Cuanto más sabe una persona, más humilde se vuelve.",
        "type": "paraphrase",
        "note": "loose"
      },
      "fr": {
        "text": "Plus on en sait, plus il faut rester humble.",
        "type": "paraphrase",
        "note": "loose"
      },
      "de": {
        "text": "Je klüger jemand wird, desto bescheidener sollte er sein.",
        "type": "paraphrase",
        "note": "loose"
      },
      "sw": {
        "text": "Mtu anapozidi kuwa na hekima, ndivyo anavyopaswa kuwa mnyenyekevu zaidi.",
        "type": "paraphrase",
        "note": "loose"
      },
      "ha": {
        "text": "Yadda mutum ke kara samun hikima, haka ya kamata ya zama mai tawali'u.",
        "type": "paraphrase",
        "note": "loose"
      },
      "fil": {
        "text": "Habang lalo namang marunong ang isang tao, dapat lalo siyang mapagpakumbaba.",
        "type": "paraphrase",
        "note": "loose"
      }
    },
    "proverb::설마가 사람 잡는다": {
      "ko": "설마가 사람 잡는다",
      "en": "Famous last words.",
      "ne": {
        "text": "बढी आत्मविश्वासले नै समस्या निम्त्याउँछ।",
        "type": "paraphrase",
        "note": "loose"
      },
      "my": {
        "text": "'ဖြစ်မှာမဟုတ်ဘူး' ဆိုတဲ့ ပေါ့ပေါ့တန်တန် ယုံကြည်မှုက အမှန်တကယ် ပြဿနာဖြစ်စေနိုင်သည်။",
        "type": "paraphrase",
        "note": "loose"
      },
      "km": {
        "text": null,
        "type": null,
        "note": null
      },
      "hi": {
        "text": "अति आत्मविश्वास मुसीबत बुला लेता है।",
        "type": "paraphrase",
        "note": "loose"
      },
      "bn": {
        "text": "বেশি আত্মবিশ্বাসই বিপদ ডেকে আনে।",
        "type": "paraphrase",
        "note": "loose"
      },
      "ar": {
        "text": "لا تقل فعلت حتى تفعل، فالحذر واجب.",
        "type": "paraphrase",
        "note": "loose"
      },
      "es": {
        "text": "Dicho y hecho, la desgracia llegó por confiado.",
        "type": "paraphrase",
        "note": "loose"
      },
      "fr": {
        "text": "À force de tenter le sort, le malheur finit par arriver.",
        "type": "paraphrase",
        "note": "loose"
      },
      "de": {
        "text": "Wer den Teufel an die Wand malt, den holt er auch.",
        "type": "paraphrase",
        "note": "loose"
      },
      "sw": {
        "text": "Kudhani 'labda haitatokea' huleta matatizo halisi.",
        "type": "paraphrase",
        "note": "loose"
      },
      "ha": {
        "text": "Amincewa cewa 'ba zai faru ba' na kawo matsala ta gaske.",
        "type": "paraphrase",
        "note": "loose"
      },
      "fil": {
        "text": "Ang walang-ingat na kumpiyansa na 'malamang hindi mangyayari' ay nagdudulot ng gulo.",
        "type": "paraphrase",
        "note": "loose"
      }
    },
