  "samples": {
    "ui.brand_slogan": {
      "en": "Old Wisdom, New Vibes.",
      "ne": "पुरानो बुद्धि, नयाँ भाइब।",
      "my": "ရှေးဉာဏ်ပညာ၊ ခေတ်သစ် Vibe။",
      "km": null,
      "hi": "पुरानी बुद्धि, नया अंदाज़।",
      "bn": "পুরনো জ্ঞান, নতুন ভাইব।",
      "ar": "حكمة قديمة، أجواء جديدة.",
      "es": "Sabiduría antigua, vibra nueva.",
      "fr": "Vieille sagesse, nouvelle vibe.",
      "de": "Alte Weisheit, neue Vibes.",
      "sw": "Hekima ya Kale, Mtindo Mpya.",
      "ha": "Tsohuwar Hikima, Sabuwar Yanayi.",
      "fil": "Lumang Karunungan, Bagong Vibe."
    },
    "ui.hero_copy": {
      "en": "Match Korean internet slang with timeless proverbs. Then remix the old wisdom in the language of memes.",
      "ne": "कोरियाली इन्टरनेट स्ल्याङलाई कालातीत उखानसँग मिलाउनुहोस्। त्यसपछि त्यो पुरानो बुद्धिलाई मिमको भाषामा नयाँ रूपमा ल्याउनुहोस्।",
      "my": "ကိုရီးယားအင်တာနက် စလင်းကို ကာလအကန့်အသတ်မရှိသော စကားပုံများနှင့် တွဲစပ်ပါ။ ထို့နောက် ရှေးဉာဏ်ပညာကို မီးမ်းဘာသာစကားဖြင့် ပြန်လည်ဖန်တီးပါ။",
      "km": null,
      "hi": "कोरियाई इंटरनेट स्लैंग को कालातीत कहावतों से मिलाएँ। फिर उस पुरानी बुद्धि को मीम्स की भाषा में नए सिरे से पेश करें।",
      "bn": "কোরিয়ান ইন্টারনেট স্ল্যাংকে চিরন্তন প্রবাদের সাথে মেলান। তারপর সেই পুরনো জ্ঞানকে মিমের ভাষায় নতুন করে সাজান।",
      "ar": "اجمع بين العامية الكورية على الإنترنت والأمثال الخالدة. ثم أعد صياغة الحكمة القديمة بلغة الميمز.",
      "es": "Empareja la jerga de internet coreana con refranes atemporales. Luego remezcla la vieja sabiduría en el lenguaje de los memes.",
      "fr": "Associez le jargon internet coréen à des proverbes intemporels. Puis remixez cette vieille sagesse dans la langue des mèmes.",
      "de": "Verbinde koreanischen Internet-Slang mit zeitlosen Sprichwörtern. Remixe dann die alte Weisheit in der Sprache der Memes.",
      "sw": "Linganisha lugha ya mitaani ya Kikorea na methali za milele. Kisha changanya hekima hiyo ya kale kwa lugha ya memes.",
      "ha": "Ka daidaita salon magana na intanet na Koriya da karin magana marasa lokaci. Sannan ka sake tsara wannan tsohuwar hikima cikin harshen memes.",
      "fil": "Itambal ang Korean internet slang sa mga walang-hanggang kasabihan. Pagkatapos, i-remix ang lumang karunungan sa wika ng mga meme."
    },
